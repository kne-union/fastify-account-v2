{
  "name": "@kne/fastify-account",
  "version": "2.0.8",
  "description": "用于用户注册登录认证.",
  "main": "index.js",
  "scripts": {
    "test": "mocha \"test/**/*.test.js\"",
    "test:coverage": "nyc mocha \"test/**/*.test.js\"",
    "init": "husky",
    "dev": "nodemon ./index.js",
    "start": "node ./index.js",
    "doc": "node ./open-api.js",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "prettier": "prettier --config .prettierrc --write '{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged"
  },
  "lint-staged": {
    "**/*.md": [
      "git add"
    ],
    "{libs/**/*,index}.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "index.js",
    "libs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/fastify-account-v2.git"
  },
  "keywords": [],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/fastify-account-v2/issues"
  },
  "homepage": "https://github.com/kne-union/fastify-account-v2#readme",
  "peerDependencies": {
    "@kne/fastify-namespace": "*",
    "@kne/fastify-sequelize": "*",
    "fastify-plugin": ">=5"
  },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "@kne/fastify-intl": "^0.1.5",
    "bcryptjs": "^3.0.2",
    "dayjs": "^1.11.13",
    "fs-extra": "^11.2.0",
    "http-errors": "^2.0.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@kne/fastify-namespace": "^1.2.1",
    "@kne/fastify-sequelize": "^4.0.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "husky": "^9.0.11",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.3",
    "nyc": "^18.0.0",
    "prettier": "^3.2.5",
    "qs": "^6.14.0",
    "sqlite3": "^5.1.7"
  }
}
